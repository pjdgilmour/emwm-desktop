#!/bin/sh
# Source-tree entry point. The package installs the compiled binary directly.
set -eu
if [ -n "${EMWM_TEST_ICONS_BINARY:-}" ]; then exec "$EMWM_TEST_ICONS_BINARY" "$@"; fi
crate=$(CDPATH='' cd -- "$(dirname -- "$0")/../../rust/desktop" && pwd)
exec cargo run --quiet --locked --manifest-path "$crate/Cargo.toml" --bin emwm-desktop-icons -- "$@"
