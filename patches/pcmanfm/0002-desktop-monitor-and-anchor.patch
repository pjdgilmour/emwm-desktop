+static gint emwm_icon_monitor(GdkScreen *screen)
+{
+    gint i, count = gdk_screen_get_n_monitors(screen);
+    if (emwm_output && strcmp(emwm_output, "primary"))
+        for (i = 0; i < count; i++)
+        {
+            char *name = gdk_screen_get_monitor_plug_name(screen, i);
+            gboolean match = !g_strcmp0(name, emwm_output);
+            g_free(name);
+            if (match) return i;
+        }
+    i = gdk_screen_get_primary_monitor(screen);
+    return (i >= 0 && i < count) ? i : 0;
+}
