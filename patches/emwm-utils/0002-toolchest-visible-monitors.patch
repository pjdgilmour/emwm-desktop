+/* Keep the Toolchest reachable after login and RandR changes, including a
+ * framebuffer with an unused gap at its origin. Do not reposition other apps. */
+static void ensure_visible(XtPointer unused, XtIntervalId *id)
+{
+    Display *dpy = XtDisplay(wshell);
+    Window client = XtWindow(wshell), root = RootWindowOfScreen(XtScreen(wshell));
+    Window frame = client, r, parent, *children, child;
+    unsigned int count;
+    XWindowAttributes attr;
+    int cx, cy, n, best = 0, area_best = -1, i, nx, ny;
+    XRRMonitorInfo *monitors;
+    visible_timer = 0;
+    if (!XGetWindowAttributes(dpy, client, &attr) || attr.map_state != IsViewable) return;
+    while (XQueryTree(dpy, frame, &r, &parent, &children, &count)) {
+        if (children) XFree(children);
+        if (parent == root || parent == None) break;
+        frame = parent;
+    }
+    if (!XGetWindowAttributes(dpy, frame, &attr)) return;
+    XTranslateCoordinates(dpy, client, root, 0, 0, &cx, &cy, &child);
+    monitors = XRRGetMonitors(dpy, root, True, &n);
+    if (!monitors || n < 1) { if (monitors) XRRFreeMonitors(monitors); return; }
+    for (i = 0; i < n; ++i) {
+        int left = attr.x > monitors[i].x ? attr.x : monitors[i].x;
+        int top = attr.y > monitors[i].y ? attr.y : monitors[i].y;
+        int right = attr.x + attr.width < monitors[i].x + monitors[i].width ?
+            attr.x + attr.width : monitors[i].x + monitors[i].width;
+        int bottom = attr.y + attr.height < monitors[i].y + monitors[i].height ?
+            attr.y + attr.height : monitors[i].y + monitors[i].height;
+        int area = (right > left && bottom > top) ? (right-left)*(bottom-top) : 0;
+        if (area > area_best || (area == area_best && monitors[i].primary)) {
+            best = i; area_best = area;
+        }
+    }
+    nx = attr.x; ny = attr.y;
+    if (nx + attr.width > monitors[best].x + monitors[best].width)
+        nx = monitors[best].x + monitors[best].width - attr.width;
+    if (ny + attr.height > monitors[best].y + monitors[best].height)
+        ny = monitors[best].y + monitors[best].height - attr.height;
+    if (nx < monitors[best].x) nx = monitors[best].x;
+    if (ny < monitors[best].y) ny = monitors[best].y;
+    if (nx != attr.x || ny != attr.y) {
+        XEvent event = {0};
+        event.xclient.type = ClientMessage;
+        event.xclient.window = client;
+        event.xclient.message_type = XInternAtom(dpy, "_NET_MOVERESIZE_WINDOW", False);
+        event.xclient.format = 32;
+        event.xclient.data.l[0] = StaticGravity | (3 << 8) | (1 << 12);
+        event.xclient.data.l[1] = nx + cx - attr.x;
+        event.xclient.data.l[2] = ny + cy - attr.y;
+        XSendEvent(dpy, root, False, SubstructureRedirectMask | SubstructureNotifyMask, &event);
+        XFlush(dpy);
+    }
+    XRRFreeMonitors(monitors);
 }
 
