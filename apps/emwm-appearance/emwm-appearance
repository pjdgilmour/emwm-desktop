#!/bin/sh
# The desktop package takes precedence over older per-user installations.
if [ -x /usr/lib/emwm-desktop/appearance/emwm-appearance ]; then
    exec /usr/lib/emwm-desktop/appearance/emwm-appearance "$@"
fi
if [ -f /usr/lib/emwm-desktop/appearance/gui.py ]; then
    exec /usr/bin/python3 /usr/lib/emwm-desktop/appearance/gui.py "$@"
fi
exec /usr/bin/python3 "$HOME/.local/share/emwm-appearance/gui.py" "$@"
