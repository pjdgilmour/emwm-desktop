+/* GTK owns the pointer grab during DnD, so the source widget is not
+ * guaranteed to receive button-release. End the hidden-item state on the
+ * DnD lifecycle signal instead, including cancelled/out-of-desktop drags. */
+static void on_drag_end(GtkWidget *widget, GdkDragContext *context)
+{
+    FmDesktop *desktop = FM_DESKTOP(widget);
+    GtkWidgetClass *parent = GTK_WIDGET_CLASS(fm_desktop_parent_class);
+    if (parent->drag_end)
+        parent->drag_end(widget, context);
+    if (desktop->dragging)
+    {
+        desktop->dragging = FALSE;
+        queue_layout_items(desktop);
+    }
+}
