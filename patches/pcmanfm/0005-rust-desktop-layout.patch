@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef EMWM_LAYOUT_H
+#define EMWM_LAYOUT_H
+
+#include <gdk/gdk.h>
+#include "app-config.h"
+
+typedef struct { GdkRectangle area, icon, text; } EmwmGeometry;
+typedef struct {
+    GdkRectangle work;
+    gint x_margin, y_margin, cell_width, cell_height, right;
+} EmwmGrid;
+typedef struct { EmwmGeometry geometry; GdkRectangle old_bounds; gint fixed; } EmwmItem;
+typedef struct {
+    gint cell_width, y_pad, icon_size, spacing;
+    gint pix_width, pix_height, label_width, label_height, label_y;
+} EmwmMetrics;
+
+void emwm_layout_icons(EmwmGrid grid, EmwmItem *items, gsize length);
+EmwmGeometry emwm_icon_geometry(gint x, gint y, EmwmMetrics metrics);
+gint emwm_anchor_x(gint x, gint old_width, gint was_right, GdkRectangle work, gint cell, gint right);
+GdkPoint emwm_snap_icon(EmwmGrid grid, gint x, gint y);
+EmwmGeometry emwm_move_icon(EmwmGeometry geometry, GdkRectangle work, gint x_margin, gint y_margin, gint x, gint y);
+GdkRectangle emwm_selection_rect(gint start_x, gint start_y, gint x, gint y);
+gint emwm_icon_hit(EmwmGeometry geometry, gint x, gint y);
+G_STATIC_ASSERT(FM_WP_STRETCH == 1 && FM_WP_FIT == 2 && FM_WP_CENTER == 3 &&
+                FM_WP_CROP == 5 && FM_WP_SCREEN == 6);
+GdkRectangle emwm_wallpaper_rect(gint mode, gint src_w, gint src_h, gint dest_w, gint dest_h, gint x, gint y);
+
+#endif
