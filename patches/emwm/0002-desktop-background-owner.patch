+Boolean DesktopOwnsBackground(WmScreenData *screen)
+{
+    ClientListEntry *entry;
+    for (entry = screen->clientList; entry; entry = entry->nextSibling)
+        if (entry->type == NORMAL_STATE && entry->pCD->desktopSurface)
+            return True;
+    return False;
+}
+
 void RestackDesktopSurfaces(WmScreenData *screen)
 {
     ClientListEntry *entry;
     for (entry = screen->clientList; entry; entry = entry->nextSibling)
         if (entry->type == NORMAL_STATE && entry->pCD->desktopSurface)
             XLowerWindow(DISPLAY, entry->pCD->clientFrameWin);
-    /* Workspace backdrops stay beneath the desktop, including after switching. */
-    if (screen->lastBackdropWin) XLowerWindow(DISPLAY, screen->lastBackdropWin);
+    /* There is only one visible background provider. Restore the native
+     * backdrop when the final desktop surface leaves (including a crash). */
+    if (DesktopOwnsBackground(screen)) {
+        int i;
+        for (i = 0; i < screen->numWorkspaces; ++i)
+            if (screen->pWS[i].backdrop.window)
+                XUnmapWindow(DISPLAY, screen->pWS[i].backdrop.window);
+    } else if (screen->pActiveWS && screen->pActiveWS->backdrop.window) {
+        Window backdrop = screen->pActiveWS->backdrop.window;
+        XLowerWindow(DISPLAY, backdrop);
+        XMapWindow(DISPLAY, backdrop);
+        screen->lastBackdropWin = backdrop;
+    }
 }
 
