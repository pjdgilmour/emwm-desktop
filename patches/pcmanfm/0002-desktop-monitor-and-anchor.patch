+/* Coalesce configuration and RandR changes. Recreate desktop surfaces only;
+ * file-manager windows and their operations stay in the same process. */
+static gboolean emwm_refresh(gpointer unused)
+{
+    gint i, screen = emwm_on_screen;
+    for (i = 0; i < n_screens; i++)
+        if (desktops[i]->dragging || desktops[i]->rubber_bending)
+            return TRUE;
+    emwm_refresh_id = 0;
+    pcmanfm_ref();
+    fm_desktop_manager_finalize();
+    fm_desktop_manager_init(screen);
+    pcmanfm_unref();
+    return FALSE;
+}
+
+static void emwm_queue_refresh(void)
+{
+    if (!emwm_refresh_id)
+        emwm_refresh_id = g_timeout_add(250, emwm_refresh, NULL);
+}
+
+static void emwm_settings_changed(GFileMonitor *monitor, GFile *file,
+                                  GFile *other, GFileMonitorEvent event, gpointer data)
+{
+    char *name = g_file_get_basename(file);
+    char *other_name = other ? g_file_get_basename(other) : NULL;
+    if (!g_strcmp0(name, "desktop.conf") || !g_strcmp0(other_name, "desktop.conf"))
+        emwm_queue_refresh();
+    g_free(name);
+    g_free(other_name);
+}
+
+static void emwm_load_settings(gint on_screen)
+{
+    char *directory, *path, *anchor;
+    GKeyFile *settings;
+    GFile *file;
+    emwm_layout = !g_strcmp0(g_getenv("EMWM_DESKTOP_LAYOUT"), "1");
+    if (!emwm_layout) return;
+    emwm_on_screen = on_screen;
+    directory = g_build_filename(g_get_user_config_dir(), "emwm-desktop", NULL);
+    g_mkdir_with_parents(directory, 0700);
+    path = g_build_filename(directory, "desktop.conf", NULL);
+    settings = g_key_file_new();
+    g_key_file_load_from_file(settings, path, 0, NULL);
+    g_free(emwm_output);
+    emwm_output = g_key_file_get_string(settings, "desktop", "monitor", NULL);
+    anchor = g_key_file_get_string(settings, "desktop", "anchor", NULL);
+    emwm_right = !g_strcmp0(anchor, "right");
+    g_free(anchor);
+    g_key_file_free(settings);
+    file = g_file_new_for_path(directory);
+    emwm_settings_monitor = g_file_monitor_directory(file, G_FILE_MONITOR_WATCH_MOVES, NULL, NULL);
+    if (emwm_settings_monitor)
+        g_signal_connect(emwm_settings_monitor, "changed", G_CALLBACK(emwm_settings_changed), NULL);
+    g_object_unref(file);
+    g_free(path);
+    g_free(directory);
+}
