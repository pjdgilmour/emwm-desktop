+
+/* Desktop integration uses the existing Motif workspace and focus machinery. */
+Boolean IsDesktopSurface(Window window)
+{
+    unsigned long count = 0, i;
+    Atom *types = FetchWindowProperty(window, ewmh_atoms[_NET_WM_WINDOW_TYPE], XA_ATOM, &count);
+    Boolean found = False;
+    for (i = 0; types && i < count; ++i)
+        if (types[i] == ewmh_atoms[_NET_WM_WINDOW_TYPE_DESKTOP]) found = True;
+    if (types) XFree(types);
+    return found;
+}
+
+void RestackDesktopSurfaces(WmScreenData *screen)
+{
+    ClientListEntry *entry;
+    for (entry = screen->clientList; entry; entry = entry->nextSibling)
+        if (entry->type == NORMAL_STATE && entry->pCD->desktopSurface)
+            XLowerWindow(DISPLAY, entry->pCD->clientFrameWin);
+    /* Workspace backdrops stay beneath the desktop, including after switching. */
+    if (screen->lastBackdropWin) XLowerWindow(DISPLAY, screen->lastBackdropWin);
+}
+
+void PublishCompositorFrame(ClientData *client)
+{
+    Atom prop = XInternAtom(DISPLAY, "_EMWM_FRAME_CLIENT", False);
+    unsigned long value = client->client;
+    XChangeProperty(DISPLAY, client->clientFrameWin, prop, XA_WINDOW, 32,
+                    PropModeReplace, (unsigned char *)&value, 1);
+}
+
+void NotifyCompositorTransition(ClientData *client, int kind, int phase)
+{
+    XEvent event;
+    char name[64];
+    Atom selection;
+    if (!kind || client->desktopSurface) return;
+    snprintf(name, sizeof(name), "_NET_WM_CM_S%d", client->pSD->screen);
+    selection = XInternAtom(DISPLAY, name, False);
+    if (!XGetSelectionOwner(DISPLAY, selection)) return;
+    memset(&event, 0, sizeof(event));
+    event.xclient.type = ClientMessage;
+    event.xclient.window = client->pSD->rootWindow;
+    event.xclient.message_type = XInternAtom(DISPLAY, "_EMWM_ANIMATION", False);
+    event.xclient.format = 32;
+    event.xclient.data.l[0] = client->clientFrameWin;
+    event.xclient.data.l[1] = kind;
+    event.xclient.data.l[2] = ICON_FRAME_WIN(client);
+    event.xclient.data.l[3] = phase;
+    XSendEvent(DISPLAY, client->pSD->rootWindow, False, SubstructureNotifyMask, &event);
+}
