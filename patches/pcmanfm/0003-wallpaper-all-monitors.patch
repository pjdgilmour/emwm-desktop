 void fm_desktop_wallpaper_changed(FmDesktop *desktop)
 {
+    int i;
+    if (emwm_layout)
+    {
+        char *current = g_strdup(desktop->conf.wallpaper);
+        g_free(emwm_wallpaper);
+        emwm_wallpaper = current;
+        emwm_wallpaper_mode = desktop->conf.wallpaper_mode;
+        emwm_have_wallpaper = TRUE;
+        /* The controller supplies one screen-sized composition per workspace.
+         * Each monitor displays its own crop, including background-only views.
+         * PCManFM's upstream CLI otherwise changes monitor zero only. */
+        for (i = 0; i < n_screens; i++)
+        {
+            FmDesktop *target = desktops[i];
+            if (target->monitor < 0) continue;
+            if (target != desktop)
+            {
+                g_free(target->conf.wallpaper);
+                target->conf.wallpaper = g_strdup(desktop->conf.wallpaper);
+                target->conf.wallpaper_mode = desktop->conf.wallpaper_mode;
+            }
+            target->conf.wallpaper_common = TRUE;
+            queue_config_save(target);
+            update_background(target, 0);
+        }
+        return;
+    }
     queue_config_save(desktop);
     update_background(desktop, 0);
 }
